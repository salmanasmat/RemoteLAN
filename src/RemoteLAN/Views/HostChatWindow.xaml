<Window x:Class="RemoteLAN.Views.HostChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RemoteLAN Chat"
        Width="340"
        MinWidth="280"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Icon="/icon.ico">
    <Window.Resources>
        <!-- Sent bubble: blue, right-aligned -->
        <Style x:Key="SentBubble" TargetType="Border">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="CornerRadius" Value="12,12,2,12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="48,4,4,4"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MaxWidth" Value="230"/>
        </Style>
        <!-- Received bubble: slate, left-aligned -->
        <Style x:Key="ReceivedBubble" TargetType="Border">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="CornerRadius" Value="12,12,12,2"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="4,4,48,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MaxWidth" Value="230"/>
        </Style>
    </Window.Resources>

    <!-- Drop shadow container -->
    <Border Margin="8" CornerRadius="12"
            Background="#FFFFFF"
            BorderBrush="#CBD5E1" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Title bar / mini-pill area -->
                <RowDefinition Height="44"/>
                <!-- Message list — hidden when collapsed -->
                <RowDefinition x:Name="BodyRow" Height="0"/>
                <!-- Input bar — hidden when collapsed -->
                <RowDefinition x:Name="InputRow" Height="0"/>
            </Grid.RowDefinitions>

            <!-- ── Title Bar / Mini-Pill ─────────────────────────────── -->
            <Border Grid.Row="0" Background="#2563EB" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    Cursor="SizeAll">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Chat icon -->
                    <TextBlock Grid.Column="0" Text="💬" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <!-- Controller name + subtitle -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ControllerNameText" Text="RemoteLAN Chat"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SubtitleText" Text="Session active"
                                   FontSize="10" Foreground="#BFDBFE"/>
                    </StackPanel>

                    <!-- Unread badge -->
                    <Border x:Name="UnreadBadge" Grid.Column="2" Background="#EF4444" CornerRadius="9"
                            MinWidth="18" Height="18" Padding="4,0" Margin="0,0,6,0"
                            VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="UnreadBadgeText" Text="0" FontSize="10" FontWeight="Bold"
                                   Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Expand/Collapse toggle -->
                    <Button x:Name="ToggleBtn" Grid.Column="3" Content="▲"
                            Width="26" Height="26" FontSize="11"
                            Background="Transparent" Foreground="#FFFFFF"
                            BorderThickness="0" Cursor="Hand" Focusable="False"
                            VerticalAlignment="Center" Margin="0,0,2,0"
                            Click="ToggleBtn_Click" ToolTip="Expand / Collapse"/>

                    <!-- Close button -->
                    <Button x:Name="CloseBtn" Grid.Column="4" Content="✕"
                            Width="26" Height="26" FontSize="12"
                            Background="Transparent" Foreground="#FFFFFF"
                            BorderThickness="0" Cursor="Hand" Focusable="False"
                            VerticalAlignment="Center"
                            Click="CloseBtn_Click" ToolTip="Close Chat"/>
                </Grid>
            </Border>

            <!-- ── Message List ──────────────────────────────────────── -->
            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <ScrollViewer x:Name="MessageScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0">
                    <StackPanel x:Name="MessageListPanel" Margin="0,4"/>
                </ScrollViewer>
            </Border>

            <!-- ── Input Row ─────────────────────────────────────────── -->
            <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="0,0,12,12"
                    BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="8,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Typing indicator -->
                    <TextBlock x:Name="TypingIndicatorText" Grid.Row="0"
                               Text="Controller is typing…"
                               FontSize="10" FontStyle="Italic" Foreground="#94A3B8"
                               Margin="4,0,0,4" Visibility="Collapsed"/>
                    <!-- Input + Send row -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="8"
                                BorderBrush="#CBD5E1" BorderThickness="1" Padding="8,0" Margin="0,0,6,0">
                            <TextBox x:Name="ChatInputBox"
                                     Background="Transparent" BorderThickness="0"
                                     FontSize="12" Foreground="#0F172A"
                                     VerticalAlignment="Center" Height="32"
                                     VerticalContentAlignment="Center"
                                     MaxLength="4096"
                                     TextWrapping="NoWrap"
                                     KeyDown="ChatInputBox_KeyDown"
                                     TextChanged="ChatInputBox_TextChanged"/>
                        </Border>
                        <Button x:Name="SendBtn" Grid.Column="1"
                                Content="➔" Width="36" Height="36"
                                Background="#2563EB" Foreground="#FFFFFF"
                                BorderThickness="0" FontSize="14" FontWeight="Bold"
                                Cursor="Hand" Focusable="False"
                                Click="SendBtn_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#94A3B8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
