<Window x:Class="RemoteLAN.Views.WebBridgeQrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RemoteLAN — Connect from Mobile" Height="780" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC" Foreground="#0F172A"
        FontFamily="Segoe UI"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Icon="/icon.ico">

    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22,16,22,16">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content -->
            <RowDefinition Height="*"/>
            <!-- Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📱" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Connect from Phone or Tablet" FontSize="17" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Scan the QR code to open RemoteLAN in your mobile browser without installing an app." FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
            <StackPanel>
                <!-- Firewall Warning Banner (if rule missing) -->
                <Border x:Name="FirewallWarningBorder" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⚠️" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Windows Firewall may block phone connection" FontSize="11.5" FontWeight="SemiBold" Foreground="#92400E"/>
                            <TextBlock Text="Add firewall rule for port 8443 so your phone can reach this PC." FontSize="10.5" Foreground="#B45309" Margin="0,1,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" x:Name="AllowFirewallBtn" Content="🛡️ Allow" Height="28" Padding="10,0" Style="{StaticResource PrimaryButtonStyle}"
                                FontSize="11" Click="AllowFirewallBtn_Click" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </Border>

                <!-- QR Code & URL Card -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                    <StackPanel>
                        <!-- QR Code Frame -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Image x:Name="QrCodeImage" Width="160" Height="160" RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True"/>
                        </Border>

                        <!-- Network Adapter Selector -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Network Interface:" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="1" x:Name="AdapterComboBox" Height="32" VerticalContentAlignment="Center" SelectionChanged="AdapterComboBox_SelectionChanged"/>
                        </Grid>

                        <!-- URL Box -->
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="UrlTextBlock" Text="https://127.0.0.1:8443" FontFamily="Consolas, monospace" FontSize="13" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" x:Name="CopyUrlBtn" Content="Copy URL" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="11" Click="CopyUrlBtn_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- PIN Code Quick-Reference Card -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="SESSION ACCESS PIN" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock x:Name="PinTextBlock" Text="------" FontSize="20" FontWeight="Bold" Foreground="#0284C7" FontFamily="Consolas, monospace" Margin="0,1,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="CopyPinBtn" Content="Copy PIN" Style="{StaticResource SecondaryButtonStyle}" Height="30" Padding="12,0" VerticalAlignment="Center" Click="CopyPinBtn_Click"/>
                    </Grid>
                </Border>

                <!-- 4 Step Connection Guide -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="How to Connect:" FontSize="12" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>

                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="1. Same Wi-Fi Network" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                            <TextBlock Text="Ensure your phone is connected to the same Wi-Fi network as this PC." FontSize="11" Foreground="#64748B"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="2. Scan the QR Code" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                            <TextBlock Text="Open the Camera app on your iPhone or Android and point at the QR code above." FontSize="11" Foreground="#64748B"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="3. Accept Security Notice (First Time Only)" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                            <TextBlock Text="In Safari, tap 'Show Details' → 'visit this website'. In Chrome, tap 'Advanced' → 'Proceed'." FontSize="11" Foreground="#64748B"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="4. Enter Access PIN" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                            <TextBlock Text="Enter the PIN shown above to begin controlling your PC." FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="⚙️ WebBridge Settings..." Style="{StaticResource SecondaryButtonStyle}" Click="OpenSettingsBtn_Click"/>
            <Button Grid.Column="2" Content="Close" Style="{StaticResource PrimaryButtonStyle}" Width="80" Click="CloseBtn_Click"/>
        </Grid>
    </Grid>
</Window>
