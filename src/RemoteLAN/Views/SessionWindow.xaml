<Window x:Class="RemoteLAN.Views.SessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RemoteLAN — Remote Desktop Session" Height="760" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC"
        FontFamily="Segoe UI"
        Icon="/icon.ico"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">
    <Grid Background="#020617">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopToolbarRow" Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="StatusBarRow" Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Peek Trigger (Active in Fullscreen only) -->
        <Border x:Name="TopPeekTrigger" Grid.RowSpan="3" Height="8" VerticalAlignment="Top"
                Background="Transparent" Panel.ZIndex="499"
                MouseEnter="TopPeekTrigger_MouseEnter" Visibility="Collapsed"/>

        <!-- Top Session Toolbar -->
        <Border x:Name="TopToolbar" Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,8"
                Panel.ZIndex="500" MouseLeave="TopToolbar_MouseLeave">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Remote Host Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/icon.png" Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                    <Border Width="10" Height="10" CornerRadius="5" Background="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="RemoteHostTitleText" Text="Connected to Remote PC" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    <Border Background="#E0F2FE" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="RemoteEndpointText" Text="127.0.0.1:9191" FontSize="11" FontWeight="SemiBold" Foreground="#0284C7"/>
                    </Border>
                </StackPanel>

                <!-- Session Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Consolidated Actions Menu Button -->
                    <Button x:Name="ActionsBtn" Content="⚡ Actions ▾" Click="ActionsBtn_Click" Padding="14,4"
                            ToolTip="Session Actions (Input, OS Login, Ctrl+Alt+Del, Power)" Focusable="False"
                            Background="#F1F5F9" Foreground="#1E293B" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" Margin="0,0,10,0">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="ActionsContextMenu">
                                <MenuItem x:Name="MenuSendRemoteInputToggle" Header="Send Remote Input" IsCheckable="True" IsChecked="True"/>
                                <Separator/>
                                <MenuItem Header="🔑 OS Login">
                                    <MenuItem Header="🔑 Enter Saved OS Password" Click="MenuEnterSavedOsPassword_Click"/>
                                    <MenuItem Header="⚙️ Set/Change OS Password..." Click="MenuConfigureOsPassword_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="MenuAutoUnlockToggle" Header="Auto-Enter Password When Locked" IsCheckable="True" IsChecked="True" Click="MenuAutoUnlockToggle_Click"/>
                                </MenuItem>
                                <MenuItem Header="⌨️ Send Ctrl+Alt+Del" Click="SendCadBtn_Click" ToolTip="Send Ctrl+Alt+Del to unlock or wake the remote sign-in screen"/>
                                <Separator/>
                                <MenuItem Header="🔒 Lock Workstation" Click="PowerLock_Click"/>
                                <MenuItem x:Name="MenuLockOnDisconnectToggle" Header="🔒 Lock Remote PC on Session End" IsCheckable="True" IsChecked="False"/>
                                <MenuItem Header="🌙 Sleep / Suspend" Click="PowerSleep_Click"/>
                                <Separator/>
                                <MenuItem Header="🔄 Restart PC..." Click="PowerRestart_Click"/>
                                <MenuItem Header="⏻ Shutdown PC..." Click="PowerShutdown_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <!-- Chat Button with unread badge -->
                    <Grid Margin="0,0,10,0" VerticalAlignment="Center">
                        <Button x:Name="ChatBtn" Content="💬 Chat" Click="ChatBtn_Click" Padding="12,4" Focusable="False"
                                Background="#F1F5F9" Foreground="#1E293B" BorderBrush="#CBD5E1" BorderThickness="1"
                                Cursor="Hand" FontWeight="Medium"/>
                        <Border x:Name="ChatUnreadBadge" Background="#EF4444" CornerRadius="8"
                                MinWidth="16" Height="16" Padding="3,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-4,-4,0" Visibility="Collapsed">
                            <TextBlock x:Name="ChatUnreadBadgeText" Text="0" FontSize="9" FontWeight="Bold"
                                       Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <Button x:Name="ToggleFullscreenBtn" Content="Fullscreen" Click="ToggleFullscreenBtn_Click" Padding="12,4" Focusable="False"
                            Background="#F1F5F9" Foreground="#1E293B" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontWeight="Medium" Margin="0,0,10,0"/>
                    <Button x:Name="DisconnectBtn" Content="Disconnect" Click="DisconnectBtn_Click" Padding="14,4" Focusable="False"
                            Background="#EF4444" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Live Performance Stats -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="FpsTextBlock" Text="0.0 FPS" Foreground="#0284C7" FontWeight="Bold" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ResolutionTextBlock" Text="-- x --" Foreground="#64748B" FontWeight="Medium" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Remote Desktop Viewport -->
        <Border Grid.Row="1" x:Name="ViewportContainer" Focusable="True" Background="#020617">
            <Image x:Name="ScreenViewport" Stretch="Uniform"
                   MouseMove="ScreenViewport_MouseMove"
                   MouseDown="ScreenViewport_MouseDown"
                   MouseUp="ScreenViewport_MouseUp"
                   MouseWheel="ScreenViewport_MouseWheel"
                   Cursor="Arrow"/>
        </Border>

        <!-- Session Status Bar -->
        <Border x:Name="StatusBarBorder" Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SessionStatusText" Text="Connected • Low Latency Direct Socket Stream" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="RemoteLAN v1.3.4" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Quick OS Password Prompt Dialog Overlay -->
        <Grid Grid.RowSpan="3" x:Name="OsPasswordPromptOverlay" Visibility="Collapsed" 
              Background="#660F172A" Panel.ZIndex="1000">
            <Border Background="#FFFFFF" CornerRadius="10" BorderBrush="#CBD5E1" BorderThickness="1"
                    Width="360" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel>
                    <TextBlock Text="Enter Windows OS Password" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                    <TextBlock Text="To unlock the remote sign-in screen automatically." FontSize="11" Foreground="#64748B" Margin="0,0,0,12"/>
                    <PasswordBox x:Name="SessionOsPasswordInput" Height="36" FontSize="14" HorizontalContentAlignment="Center"
                                 Margin="0,0,0,8" KeyDown="SessionOsPasswordInput_KeyDown"/>
                    <CheckBox x:Name="SessionRememberOsPasswordCheckBox" Content="Save password for this computer" IsChecked="True"
                              FontSize="11.5" Foreground="#334155" Margin="0,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Height="34" Click="CancelSessionOsPasswordPrompt_Click"
                                Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand"/>
                        <Button Grid.Column="2" Content="Unlock Now ➔" Height="34" Click="SubmitSessionOsPasswordPrompt_Click"
                                Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        <!-- ─── Chat Drawer (right-side slide panel, ZIndex 490) ──────────── -->
        <Border x:Name="ChatDrawer" Grid.RowSpan="3"
                Width="320" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0"
                Panel.ZIndex="490" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>    <!-- Header -->
                    <RowDefinition Height="*"/>       <!-- Message list -->
                    <RowDefinition Height="Auto"/>    <!-- Typing indicator -->
                    <RowDefinition Height="Auto"/>    <!-- Input row -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="#2563EB" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="💬 Chat" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock x:Name="ChatDrawerSubtitle" Text="Ephemeral — cleared on disconnect"
                                       FontSize="10" Foreground="#BFDBFE"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Width="28" Height="28"
                                Background="Transparent" Foreground="#FFFFFF" BorderThickness="0"
                                FontSize="14" FontWeight="Bold" Cursor="Hand" Focusable="False"
                                Click="ChatCloseBtn_Click"/>
                    </Grid>
                </Border>

                <!-- Message list -->
                <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="#F8FAFC">
                    <StackPanel x:Name="ChatMessageListPanel" Margin="0,6"/>
                </ScrollViewer>

                <!-- Typing indicator -->
                <TextBlock x:Name="ChatTypingIndicatorText" Grid.Row="2"
                           Text="Remote is typing…"
                           FontSize="10" FontStyle="Italic" Foreground="#94A3B8"
                           Margin="12,4" Visibility="Collapsed"/>

                <!-- Input row -->
                <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="8,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="8"
                                BorderBrush="#CBD5E1" BorderThickness="1" Padding="8,0" Margin="0,0,6,0">
                            <TextBox x:Name="ChatInputBox"
                                     Background="Transparent" BorderThickness="0"
                                     FontSize="12" Foreground="#0F172A"
                                     VerticalAlignment="Center" Height="34"
                                     VerticalContentAlignment="Center"
                                     MaxLength="4096"
                                     KeyDown="ChatInputBox_KeyDown"
                                     TextChanged="ChatInputBox_TextChanged"/>
                        </Border>
                        <Button x:Name="ChatSendBtn" Grid.Column="1"
                                Content="➔" Width="36" Height="36"
                                Background="#2563EB" Foreground="#FFFFFF"
                                BorderThickness="0" FontSize="14" FontWeight="Bold"
                                Cursor="Hand" Focusable="False"
                                Click="ChatSendBtn_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#94A3B8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

    </Grid>
</Window>
