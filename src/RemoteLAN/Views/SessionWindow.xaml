<Window x:Class="RemoteLAN.Views.SessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RemoteLAN — Remote Desktop Session" Height="760" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC"
        FontFamily="Segoe UI"
        Icon="/icon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Session Toolbar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Remote Host Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/icon.png" Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                    <Border Width="10" Height="10" CornerRadius="5" Background="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="RemoteHostTitleText" Text="Connected to Remote PC" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    <Border Background="#E0F2FE" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="RemoteEndpointText" Text="127.0.0.1:9191" FontSize="11" FontWeight="SemiBold" Foreground="#0284C7"/>
                    </Border>
                </StackPanel>

                <!-- Session Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <CheckBox x:Name="EnableInputCheckBox" Content="Send Remote Input" IsChecked="True" Foreground="#334155" 
                              VerticalAlignment="Center" Margin="0,0,16,0" Cursor="Hand" FontWeight="Medium"/>
                    <Button x:Name="SendCadBtn" Content="Ctrl+Alt+Del" Click="SendCadBtn_Click" Padding="12,4"
                            ToolTip="Send Ctrl+Alt+Del to unlock or wake the remote sign-in screen"
                            Background="#F1F5F9" Foreground="#1E293B" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontWeight="Medium" Margin="0,0,10,0"/>
                    <Button x:Name="UnlockOsBtn" Content="🔑 OS Login" Click="UnlockOsBtn_Click" Padding="12,4"
                            ToolTip="Auto-enter Windows OS password to unlock remote sign-in screen"
                            Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#93C5FD" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" Margin="0,0,10,0">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="🔑 Enter Saved OS Password" Click="MenuEnterSavedOsPassword_Click"/>
                                <MenuItem Header="⚙️ Set/Change OS Password..." Click="MenuConfigureOsPassword_Click"/>
                                <Separator/>
                                <MenuItem x:Name="MenuAutoUnlockToggle" Header="Auto-Enter Password When Locked" IsCheckable="True" IsChecked="True" Click="MenuAutoUnlockToggle_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="PowerActionsBtn" Content="⚡ Power" Click="PowerActionsBtn_Click" Padding="12,4"
                            ToolTip="Remote system power actions (Lock, Sleep, Restart, Shutdown)"
                            Background="#F1F5F9" Foreground="#1E293B" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontWeight="Medium" Margin="0,0,10,0">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="🔒 Lock Workstation" Click="PowerLock_Click"/>
                                <MenuItem Header="🌙 Sleep / Suspend" Click="PowerSleep_Click"/>
                                <Separator/>
                                <MenuItem Header="🔄 Restart PC..." Click="PowerRestart_Click"/>
                                <MenuItem Header="⏻ Shutdown PC..." Click="PowerShutdown_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="ToggleFullscreenBtn" Content="Fullscreen" Click="ToggleFullscreenBtn_Click" Padding="12,4"
                            Background="#F1F5F9" Foreground="#1E293B" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontWeight="Medium" Margin="0,0,10,0"/>
                    <Button x:Name="DisconnectBtn" Content="Disconnect" Click="DisconnectBtn_Click" Padding="14,4"
                            Background="#EF4444" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Live Performance Stats -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="FpsTextBlock" Text="0.0 FPS" Foreground="#0284C7" FontWeight="Bold" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ResolutionTextBlock" Text="-- x --" Foreground="#64748B" FontWeight="Medium" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Remote Desktop Viewport -->
        <Border Grid.Row="1" x:Name="ViewportContainer" Focusable="True" Background="#020617"
                PreviewKeyDown="ViewportContainer_PreviewKeyDown"
                PreviewKeyUp="ViewportContainer_PreviewKeyUp">
            <Image x:Name="ScreenViewport" Stretch="Uniform"
                   MouseMove="ScreenViewport_MouseMove"
                   MouseDown="ScreenViewport_MouseDown"
                   MouseUp="ScreenViewport_MouseUp"
                   MouseWheel="ScreenViewport_MouseWheel"
                   Cursor="Arrow"/>
        </Border>

        <!-- Session Status Bar -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SessionStatusText" Text="Connected • Low Latency Direct Socket Stream" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="RemoteLAN v1.1.0" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Quick OS Password Prompt Dialog Overlay -->
        <Grid Grid.RowSpan="3" x:Name="OsPasswordPromptOverlay" Visibility="Collapsed" 
              Background="#660F172A" Panel.ZIndex="1000">
            <Border Background="#FFFFFF" CornerRadius="10" BorderBrush="#CBD5E1" BorderThickness="1"
                    Width="360" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel>
                    <TextBlock Text="Enter Windows OS Password" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                    <TextBlock Text="To unlock the remote sign-in screen automatically." FontSize="11" Foreground="#64748B" Margin="0,0,0,12"/>
                    <PasswordBox x:Name="SessionOsPasswordInput" Height="36" FontSize="14" HorizontalContentAlignment="Center"
                                 Margin="0,0,0,8" KeyDown="SessionOsPasswordInput_KeyDown"/>
                    <CheckBox x:Name="SessionRememberOsPasswordCheckBox" Content="Save password for this computer" IsChecked="True"
                              FontSize="11.5" Foreground="#334155" Margin="0,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Height="34" Click="CancelSessionOsPasswordPrompt_Click"
                                Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand"/>
                        <Button Grid.Column="2" Content="Unlock Now ➔" Height="34" Click="SubmitSessionOsPasswordPrompt_Click"
                                Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
