<Window x:Class="RemoteLAN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RemoteLAN"
        mc:Ignorable="d"
        Title="RemoteLAN" Height="640" Width="980"
        MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC" Foreground="#0F172A"
        FontFamily="Segoe UI"
        ResizeMode="CanResizeWithGrip"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        Icon="/icon.ico"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- Primary Action Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Neutral Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Input Box Style (No vertical clipping, razor sharp) -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Focusable="False" 
                                          HorizontalScrollBarVisibility="Hidden" 
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern PasswordBox Style -->
        <Style x:Key="ModernPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Focusable="False" 
                                          HorizontalScrollBarVisibility="Hidden" 
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom ToggleButton for Modern ComboBox -->
        <ControlTemplate x:Key="ModernComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="templateRoot" 
                    Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}" 
                    CornerRadius="7" 
                    SnapsToDevicePixels="True">
                <Border x:Name="splitBorder" 
                        Width="28" 
                        HorizontalAlignment="Right" 
                        SnapsToDevicePixels="True">
                    <Path x:Name="arrow" 
                          Data="M 0,0 L 4,4 L 8,0" 
                          Stroke="#64748B" 
                          StrokeThickness="1.5" 
                          StrokeStartLineCap="Round" 
                          StrokeEndLineCap="Round" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center" 
                          SnapsToDevicePixels="True"/>
                </Border>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#94A3B8"/>
                    <Setter TargetName="templateRoot" Property="Background" Value="#F8FAFC"/>
                    <Setter TargetName="arrow" Property="Stroke" Value="#1E293B"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#2563EB"/>
                    <Setter TargetName="templateRoot" Property="BorderThickness" Value="1.5"/>
                    <Setter TargetName="arrow" Property="Stroke" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="templateRoot" Property="Opacity" Value="0.6"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Modern ComboBoxItem Style -->
        <Style x:Key="ModernComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Margin="4,2" 
                                Padding="{TemplateBinding Padding}" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#BFDBFE"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="#DBEAFE"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#93C5FD"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox Style -->
        <Style x:Key="ModernIpComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="8,0,28,0"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot" SnapsToDevicePixels="True">
                            <ToggleButton x:Name="toggleButton" 
                                          Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}" 
                                          Template="{StaticResource ModernComboBoxToggleButtonTemplate}" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="contentPresenter" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" 
                                              HorizontalAlignment="Stretch" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                              Margin="{TemplateBinding Padding}" 
                                              IsHitTestVisible="False" 
                                              SnapsToDevicePixels="True"/>
                            <Popup x:Name="PART_Popup" 
                                   AllowsTransparency="True" 
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                                   Placement="Bottom" 
                                   PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder" 
                                        Background="#FFFFFF" 
                                        BorderBrush="#CBD5E1" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        MinWidth="260" 
                                        MaxHeight="260" 
                                        Margin="0,4,0,8" 
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.12"/>
                                    </Border.Effect>
                                    <ScrollViewer x:Name="dropDownScrollViewer" 
                                                  Margin="2" 
                                                  SnapsToDevicePixels="True">
                                        <ItemsPresenter x:Name="ItemsPresenter" 
                                                        KeyboardNavigation.DirectionalNavigation="Contained" 
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="dropDownBorder" Property="Height" Value="95"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="toggleButton" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="toggleButton" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="toggleButton" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card 3-Dots Kebab Button Style -->
        <Style x:Key="CardKebabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Crisp Square Device Tile Style matching cards.png -->
        <Style x:Key="DeviceTileBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="#94A3B8"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Discovered PC ListBox Item Container -->
        <Style x:Key="DiscoveredDeviceItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Discovered PC Card DataTemplate (Exact match to cards.png) -->
        <DataTemplate x:Key="DiscoveredDeviceCardTemplate">
            <Border Style="{StaticResource DeviceTileBorderStyle}" Width="196" Height="142"
                    Opacity="{Binding CardOpacity}"
                    SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>   <!-- Colored Header / Screen Preview Area -->
                        <RowDefinition Height="46"/>  <!-- White/Light Footer Bar -->
                    </Grid.RowDefinitions>

                    <!-- Top Colored Header Area (Pastel Background + Windows Logo + Machine Name + Connection Badge) -->
                    <Border Grid.Row="0" CornerRadius="13,13,0,0" Background="{Binding HeaderBackgroundBrush}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Connection Type Badge (e.g. Ethernet / WiFi) -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                                    Background="#33000000" CornerRadius="4" Padding="5,2">
                                <TextBlock Text="{Binding InterfaceType}" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            </Border>

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <!-- Crisp Windows Perspective Logo -->
                                <Path Data="M 0,3.5 L 14,1.8 L 14,14 L 0,14 Z M 16,1.5 L 34,0 L 34,14 L 16,14 Z M 0,16 L 14,16 L 14,28.2 L 0,26.5 Z M 16,16 L 34,16 L 34,30 L 16,28.5 Z"
                                      Fill="#FFFFFF" Stretch="Uniform" Width="36" Height="36" HorizontalAlignment="Center" Margin="0,0,0,6"
                                      SnapsToDevicePixels="True"/>
                                <!-- Device / User Name -->
                                <TextBlock Text="{Binding MachineName}" FontSize="12" FontWeight="Medium" Foreground="#FFFFFF"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="174"
                                           TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Bottom Bar (Status Dot + IP Address + 3-Dots Kebab Menu) -->
                    <Border Grid.Row="1" CornerRadius="0,0,13,13" Background="#F1F3F5" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
                            Padding="14,0" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Status Dot & IP Address -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="8" Height="8" CornerRadius="4" Background="{Binding StatusDotBrush}" Margin="0,0,8,0" VerticalAlignment="Center"
                                        ToolTip="{Binding StatusText}"/>
                                <TextBlock Text="{Binding IpAddress}" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"
                                           TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"/>
                            </StackPanel>

                            <!-- Right: 3-Dots Menu Button -->
                            <Button Grid.Column="1" Style="{StaticResource CardKebabButtonStyle}" Click="CardKebab_Click" VerticalAlignment="Center" ToolTip="Device options">
                                <Path Data="M 6,3 A 2,2 0 1 1 6,7 A 2,2 0 1 1 6,3 Z M 6,9 A 2,2 0 1 1 6,13 A 2,2 0 1 1 6,9 Z M 6,15 A 2,2 0 1 1 6,19 A 2,2 0 1 1 6,15 Z"
                                      Fill="#64748B" Stretch="Uniform" Width="4" Height="14" SnapsToDevicePixels="True"/>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Connect" Click="CardMenuConnect_Click" FontWeight="SemiBold"/>
                                        <MenuItem Header="Copy IP Address" Click="CardMenuCopyIp_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Configure OS Password..." Click="CardMenuConfigureOsPassword_Click"/>
                                        <MenuItem Header="Forget Saved Remote Code" Click="CardMenuForgetPassword_Click"/>
                                        <MenuItem Header="Forget Saved OS Password" Click="CardMenuForgetOsPassword_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Remove from History" Click="CardMenuRemoveFromHistory_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Pane: My PC Info -->
            <ColumnDefinition Width="284"/>
            <!-- Right Pane: Main Workspace -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================================= -->
        <!-- LEFT VERTICAL PANE: MY PC INFO & STATUS                            -->
        <!-- ================================================================= -->
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="20"
                SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- App Brand & Live Status -->
                    <RowDefinition Height="Auto"/> <!-- Separator -->
                    <RowDefinition Height="*"/>    <!-- Device Identity & Security PIN -->
                    <RowDefinition Height="Auto"/> <!-- Active Incoming Session Banner -->
                    <RowDefinition Height="Auto"/> <!-- Footer Note -->
                </Grid.RowDefinitions>

                <!-- Header: App Name & Status -->
                <StackPanel Grid.Row="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Brand Icon -->
                        <Image Grid.Column="0" Source="/icon.png" Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>

                        <!-- Brand Name & Version -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="RemoteLAN" FontSize="18" FontWeight="Bold" Foreground="#0F172A"
                                           TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"/>
                                <Border Background="#E0F2FE" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                    <TextBlock Text="v1.3.0" FontSize="10" FontWeight="SemiBold" Foreground="#0284C7"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="LAN Remote Desktop" FontSize="11" Foreground="#64748B" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Divider -->
                <Separator Grid.Row="1" Background="#F1F5F9" Margin="0,16,0,16"/>

                <!-- Middle Content: This PC Info -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Device Name Card -->
                        <TextBlock Text="THIS DEVICE" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="M 4,6 L 20,6 C 20.6,6 21,6.4 21,7 L 21,16 L 3,16 L 3,7 C 3,6.4 3.4,6 4,6 Z M 1,17 L 23,17 C 23.6,17 24,17.4 24,18 L 24,19 C 24,19.6 23.6,20 23,20 L 1,20 C 0.4,20 0,19.6 0,19 L 0,18 C 0,17.4 0.4,17 1,17 Z"
                                      Fill="#64748B" Stretch="Uniform" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="HostDeviceNameText" Text="DESKTOP-LOCAL" FontSize="13" FontWeight="Bold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Local Computer" FontSize="11" Foreground="#94A3B8" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Local IP Address -->
                        <TextBlock Text="YOUR IP ADDRESS" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="LocalIpsComboBox" 
                                      Style="{StaticResource ModernIpComboBoxStyle}" 
                                      Height="42"
                                      ToolTip="Select active IP address to share with remote devices"
                                      SnapsToDevicePixels="True">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Network Type Icon + IP Address (Always visible, prominent) -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="18" Height="18" CornerRadius="4" 
                                                        Background="{Binding BadgeBackgroundBrush}" 
                                                        VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <Path Data="{Binding IconData}" Fill="{Binding IconBrush}" Stretch="Uniform" 
                                                          Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                          SnapsToDevicePixels="True"/>
                                                </Border>
                                                <TextBlock Text="{Binding IpAddress}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" 
                                                           FontFamily="Consolas, Segoe UI" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                                            </StackPanel>

                                            <!-- Adapter Name (visible when space permits) -->
                                            <TextBlock Grid.Column="1" Text="{Binding InterfaceName}" FontSize="10" Foreground="#64748B" 
                                                       TextTrimming="CharacterEllipsis" Margin="6,0,4,0" VerticalAlignment="Center" SnapsToDevicePixels="True"/>

                                            <!-- Compact Badge -->
                                            <Border Grid.Column="2" Background="{Binding BadgeBackgroundBrush}" CornerRadius="3" Padding="5,1.5" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BadgeText}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding BadgeForegroundBrush}"
                                                           SnapsToDevicePixels="True"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button x:Name="CopyIpBtn" Grid.Column="1" Content="Copy" Margin="6,0,0,0" Style="{StaticResource SecondaryButtonStyle}" 
                                    Height="42" Click="CopyIp_Click" ToolTip="Copy selected IP address to clipboard"/>
                        </Grid>

                        <!-- Session Access Code -->
                        <TextBlock Text="SESSION ACCESS CODE" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                        <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1.5" CornerRadius="8" Padding="10,8" Margin="0,0,0,8"
                                SnapsToDevicePixels="True">
                            <TextBlock x:Name="PinTextBlock" Text="7K2M9X" FontSize="26" FontWeight="Bold" Foreground="#0284C7" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas, Segoe UI"
                                       TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"/>
                        </Border>

                        <!-- Code Action Buttons -->
                        <StackPanel Margin="0,0,0,14">
                            <!-- Full Width Copy Button -->
                            <Button x:Name="CopyPinBtn" Content="Copy" Height="34" Margin="0,0,0,6" 
                                    Style="{StaticResource SecondaryButtonStyle}" FontWeight="SemiBold"
                                    Click="CopyPin_Click" ToolTip="Copy session access code to clipboard"/>

                            <!-- New and Custom Buttons Below -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="RegeneratePinBtn" Grid.Column="0" Content="New" Height="32" 
                                        Style="{StaticResource SecondaryButtonStyle}" Click="RegeneratePin_Click"
                                        ToolTip="Generate a new random access code"/>
                                <Button x:Name="CustomPinBtn" Grid.Column="2" Content="Custom..." Height="32" 
                                        Style="{StaticResource SecondaryButtonStyle}" Click="CustomPin_Click"
                                        ToolTip="Set a custom access code"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Active Incoming Client Card (Conditional) -->
                <Border Grid.Row="3" x:Name="ActiveClientCard" Visibility="Collapsed" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,10,0,0"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CONNECTED VIEWER" FontSize="10" FontWeight="Bold" Foreground="#059669"/>
                            <TextBlock x:Name="ActiveClientEndpointText" Text="192.168.1.50" FontSize="12" FontWeight="SemiBold" Foreground="#065F46" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Disconnect" Padding="10,4" Background="#EF4444" Foreground="#FFFFFF"
                                BorderThickness="0" Click="DisconnectIncomingClient_Click" Cursor="Hand" FontWeight="SemiBold" FontSize="11"/>
                    </Grid>
                </Border>

                <!-- Bottom Action & Settings -->
                <StackPanel Grid.Row="4" Margin="0,14,0,0">
                    <Button Content="⚙️  Settings" Style="{StaticResource SecondaryButtonStyle}" Height="36" 
                            HorizontalAlignment="Stretch" FontSize="12" FontWeight="SemiBold"
                            Click="OpenSettings_Click" ToolTip="Open Settings (Security, Preferences, and About)"/>
                    <TextBlock Text="Direct LAN Connection • Private" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- RIGHT PANE: TOP CONNECTION BAR, DISCOVERED PCS, & BOTTOM STATUS BAR-->
        <!-- ================================================================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Row 0: Top Horizontal Connection Header -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Discovered PCs Grid Workspace -->
                <RowDefinition Height="*"/>
                <!-- Row 2: Bottom Status Bar -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Horizontal Connection Bar (Manual IP Entry) -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,16"
                    SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Elevation Advisory Banner (Visible only when non-elevated) -->
                    <Border x:Name="ElevationBanner" Grid.Row="0" Margin="0,0,0,12" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,8" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🛡️" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="Run RemoteLAN as Administrator to view and unlock the Windows sign-in screen remotely."
                                       FontSize="11.5" Foreground="#1E40AF" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button Grid.Column="2" Content="Restart as Admin" Height="26" Padding="10,0" Style="{StaticResource PrimaryButtonStyle}"
                                    FontSize="11" Click="RestartAsAdminBtn_Click" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="1" Text="Connect to Remote Device" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Target Address Field -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="REMOTE ADDRESS" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
                            <TextBox x:Name="TargetIpTextBox" Style="{StaticResource ModernTextBoxStyle}" Height="40"
                                     KeyDown="ConnectionInput_KeyDown"/>
                        </StackPanel>

                        <!-- Connect Action Button -->
                        <Button Grid.Column="2" x:Name="ConnectRemoteBtn" Content="Connect ➔" 
                                Style="{StaticResource PrimaryButtonStyle}" Height="40" VerticalAlignment="Bottom"
                                Click="ConnectRemoteBtn_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Discovered Devices Central Workspace -->
            <Grid Grid.Row="1" Margin="24">
                <Grid.RowDefinitions>
                    <!-- Workspace Title & Scanning Indicator -->
                    <RowDefinition Height="Auto"/>
                    <!-- Discovered Cards Area -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Workspace Section Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Discovered Devices" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Computers running RemoteLAN on your local network • Click any device to connect" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Auto-Discovery Active Badge -->
                    <Border Grid.Column="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="10,5" VerticalAlignment="Center"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="7" Height="7" CornerRadius="3.5" Background="#2563EB" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Auto-discovering LAN" FontSize="11" FontWeight="SemiBold" Foreground="#1D4ED8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Discovered PCs Area: Empty State or Grid of Square Cards -->
                <Grid Grid.Row="1">
                    <!-- Friendly Empty State -->
                    <Border x:Name="DiscoveredEmptyStateBorder" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" 
                            CornerRadius="12" Padding="32" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Visibility="Collapsed"
                            SnapsToDevicePixels="True">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="56" Height="56" CornerRadius="28" Background="#F1F5F9" HorizontalAlignment="Center" Margin="0,0,0,14"
                                    SnapsToDevicePixels="True">
                                <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 12,6 C 15.31,6 18,8.69 18,12 C 18,15.31 15.31,18 12,18 C 8.69,18 6,15.31 6,12 C 6,8.69 8.69,6 12,6 Z M 12,10 C 13.1,10 14,10.9 14,12 C 14,13.1 13.1,14 12,14 C 10.9,14 10,13.1 10,12 Z"
                                      Fill="#94A3B8" Stretch="Uniform" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                            </Border>
                            <TextBlock Text="Searching for devices on your network..." FontSize="15" FontWeight="SemiBold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                            <TextBlock Text="Other PCs running RemoteLAN will automatically appear here as square tiles. Ensure both computers are connected to the same LAN." 
                                       FontSize="12" Foreground="#64748B" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="18"/>
                        </StackPanel>
                    </Border>

                    <!-- Discovered PCs Grid (WrapPanel) -->
                    <ListBox x:Name="DiscoveredPcsListBox" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemContainerStyle="{StaticResource DiscoveredDeviceItemStyle}"
                             ItemTemplate="{StaticResource DiscoveredDeviceCardTemplate}"
                             SelectionChanged="DiscoveredPcsListBox_SelectionChanged"
                             MouseDoubleClick="DiscoveredPcsListBox_MouseDoubleClick"
                             SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </Grid>
            </Grid>

            <!-- ============================================================= -->
            <!-- BOTTOM STATUS BAR (Ready to Connect Indicator)                -->
            <!-- ============================================================= -->
            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,9"
                    SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Status Indicator & Text -->
                        <ColumnDefinition Width="*"/>
                        <!-- Discovered Devices Summary -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" x:Name="ConnectionStatusDot" Background="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ConnectionStatusText" Text="Ready to connect" FontSize="12" FontWeight="Medium" Foreground="#475569" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" x:Name="DiscoveredDevicesCountText" Text="Scanning local network..." FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- PIN POPUP MODAL OVERLAY (Used when connecting via Discovered Cards)-->
        <!-- ================================================================= -->
        <Grid Grid.ColumnSpan="2" x:Name="PinModalOverlay" Visibility="Collapsed" 
              Background="#660F172A" Panel.ZIndex="1000" MouseDown="PinModalOverlay_MouseDown"
              SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1" 
                    Width="380" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24"
                    SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header: Title & Close 'X' -->
                        <RowDefinition Height="Auto"/> <!-- Target Device Card Info -->
                        <RowDefinition Height="Auto"/> <!-- PIN Input Field -->
                        <RowDefinition Height="Auto"/> <!-- Error / Status Feedback -->
                        <RowDefinition Height="Auto"/> <!-- Action Buttons: Connect / Cancel -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header with Close Button -->
                    <Grid Grid.Row="0">
                        <TextBlock Text="Connect to Remote Device" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0" Foreground="#64748B" FontSize="13" FontWeight="Bold"
                                Cursor="Hand" Click="ClosePinModal_Click"/>
                    </Grid>

                    <!-- Row 1: Target Device Info Badge -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,16,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path Data="M 2,3 L 22,3 C 22.6,3 23,3.4 23,4 L 23,17 C 23,17.6 22.6,18 22,18 L 15,18 L 16,21 L 18,21 C 18.6,21 19,21.4 19,22 C 19,22.6 18.6,23 18,23 L 6,23 C 5.4,23 5,22.6 5,22 C 5,21.4 5.4,21 6,21 L 8,21 L 9,18 L 2,18 C 1.4,18 1,17.6 1,17 L 1,4 C 1,3.4 1.4,3 2,3 Z M 3,5 L 3,16 L 21,16 L 21,5 Z" 
                                      Fill="#2563EB" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                            </Border>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="ModalDeviceNameText" Text="DESKTOP-TARGET" FontSize="14" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                <StackPanel x:Name="ModalSingleIpPanel" Orientation="Horizontal" Margin="0,1,0,0">
                                    <TextBlock x:Name="ModalDeviceIpText" Text="192.168.1.50" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <Border x:Name="ModalInterfaceBadge" Background="#EFF6FF" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="ModalInterfaceBadgeText" Text="Ethernet" FontSize="10" FontWeight="SemiBold" Foreground="#2563EB"/>
                                    </Border>
                                </StackPanel>
                                <ComboBox x:Name="ModalEndpointsComboBox" Visibility="Collapsed" Height="34" Margin="0,4,0,0"
                                          Style="{StaticResource ModernIpComboBoxStyle}"
                                          SelectionChanged="ModalEndpointsComboBox_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="18" Height="18" CornerRadius="3" 
                                                            Background="{Binding BadgeBackgroundBrush}" 
                                                            VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <Path Data="{Binding IconData}" Fill="{Binding IconBrush}" Stretch="Uniform" 
                                                              Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                              SnapsToDevicePixels="True"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding IpAddress}" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" 
                                                               FontFamily="Consolas, Segoe UI" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="{Binding BadgeBackgroundBrush}" CornerRadius="3" Padding="5,1.5" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding InterfaceType}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding BadgeForegroundBrush}"
                                                               SnapsToDevicePixels="True"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 2: PIN Input Field -->
                    <StackPanel Grid.Row="2">
                        <!-- Waiting for Approval / PIN Prompt Banner -->
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                            <TextBlock Text="⏳ Waiting for remote user to accept... Or enter password/PIN below to connect immediately:"
                                       FontSize="11" Foreground="#1E40AF" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="ACCESS CODE OR PASSWORD" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                        <TextBox x:Name="ModalPinTextBox" Style="{StaticResource ModernTextBoxStyle}" Height="38"
                                 FontSize="17" FontWeight="Bold" HorizontalContentAlignment="Center" FontFamily="Consolas, Segoe UI"
                                 KeyDown="ModalPinTextBox_KeyDown"/>
                        <CheckBox x:Name="SaveModalPasswordCheckBox" Content="Remember connection code for this device" 
                                  IsChecked="True" FontSize="12" FontWeight="Medium" Foreground="#334155" Margin="0,8,0,0" Cursor="Hand"/>

                        <!-- Windows OS Password (Optional) -->
                        <TextBlock Text="WINDOWS OS PASSWORD (OPTIONAL)" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,12,0,6"/>
                        <PasswordBox x:Name="ModalOsPasswordBox" Style="{StaticResource ModernPasswordBoxStyle}" Height="38"
                                     FontSize="14" HorizontalContentAlignment="Center"
                                     KeyDown="ModalOsPasswordBox_KeyDown"/>
                        <CheckBox x:Name="SaveModalOsPasswordCheckBox" Content="Remember OS password (for auto-unlock)" 
                                  IsChecked="True" FontSize="12" FontWeight="Medium" Foreground="#334155" Margin="0,8,0,0" Cursor="Hand"/>
                        <TextBlock Text="Used to automatically unlock the remote Windows sign-in screen." FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Row 3: Modal Status / Error Feedback -->
                    <TextBlock Grid.Row="3" x:Name="ModalStatusText" Text="" FontSize="11" FontWeight="SemiBold" Foreground="#DC2626" 
                               HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed"/>

                    <!-- Row 4: Action Buttons -->
                    <StackPanel Grid.Row="4" Margin="0,18,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Cancel" Height="38" Style="{StaticResource SecondaryButtonStyle}" Click="ClosePinModal_Click"/>
                            <Button Grid.Column="2" x:Name="ModalConnectBtn" Content="Connect ➔" Height="38" Style="{StaticResource PrimaryButtonStyle}" Click="ModalConnectBtn_Click"/>
                        </Grid>
                        <Button x:Name="ModalForgetPasswordBtn" Content="Forget saved connection code" 
                                Background="Transparent" BorderThickness="0" Foreground="#DC2626" FontSize="11" FontWeight="Medium"
                                Cursor="Hand" HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed"
                                Click="ModalForgetPasswordBtn_Click"/>
                        <Button x:Name="ModalForgetOsPasswordBtn" Content="Forget saved OS password" 
                                Background="Transparent" BorderThickness="0" Foreground="#DC2626" FontSize="11" FontWeight="Medium"
                                Cursor="Hand" HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="Collapsed"
                                Click="ModalForgetOsPasswordBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- INCOMING CONNECTION REQUEST OVERLAY (Accept / Reject Prompt)       -->
        <!-- ================================================================= -->
        <Grid Grid.ColumnSpan="2" x:Name="IncomingRequestOverlay" Visibility="Collapsed" 
              Background="#660F172A" Panel.ZIndex="1200"
              SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1" 
                    Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24"
                    SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Requester Badge -->
                        <RowDefinition Height="Auto"/> <!-- Info Note -->
                        <RowDefinition Height="Auto"/> <!-- Buttons: Accept / Reject -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
                        <Border Width="34" Height="34" CornerRadius="17" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="🔔" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Incoming Connection Request" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="A remote device wants to control your screen" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Requester Badge -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="💻" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="IncomingRequesterNameText" Text="DESKTOP-REMOTE" FontSize="14" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="IncomingRequesterEndpointText" Text="192.168.1.100" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Info Note -->
                    <TextBlock Grid.Row="2" Text="Accepting allows this user to view your display and send mouse and keyboard input." 
                               FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,18"/>

                    <!-- Action Buttons -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="RejectIncomingBtn" Content="✕  Dismiss" Height="40" 
                                Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1"
                                FontSize="12.5" FontWeight="SemiBold" Cursor="Hand" Click="RejectIncomingBtn_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Grid.Column="2" x:Name="AcceptIncomingBtn" Content="✓  Accept" Height="40" 
                                Background="#10B981" Foreground="#FFFFFF" BorderThickness="0"
                                FontSize="12.5" FontWeight="Bold" Cursor="Hand" Click="AcceptIncomingBtn_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- CUSTOM SESSION CODE MODAL OVERLAY                                 -->
        <!-- ================================================================= -->
        <Grid Grid.ColumnSpan="2" x:Name="CustomCodeModalOverlay" Visibility="Collapsed" 
              Background="#660F172A" Panel.ZIndex="1002" MouseDown="CustomCodeModalOverlay_MouseDown"
              SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1" 
                    Width="360" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24"
                    SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="Set Custom Access Code" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0" Foreground="#64748B" FontSize="13" FontWeight="Bold"
                                Cursor="Hand" Click="CloseCustomCodeModal_Click"/>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="Enter an alphanumeric access code for this session (minimum 4 characters)."
                               FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,10,0,16"/>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="CUSTOM CODE" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
                        <TextBox x:Name="CustomCodeTextBox" Style="{StaticResource ModernTextBoxStyle}" Height="40"
                                 FontSize="16" FontWeight="Bold" HorizontalContentAlignment="Center" FontFamily="Consolas, Segoe UI"
                                 KeyDown="CustomCodeTextBox_KeyDown"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" x:Name="CustomCodeModalStatusText" Text="" FontSize="11" FontWeight="SemiBold" Foreground="#DC2626" 
                               HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed"/>

                    <Grid Grid.Row="4" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Height="38" Style="{StaticResource SecondaryButtonStyle}" Click="CloseCustomCodeModal_Click"/>
                        <Button Grid.Column="2" Content="Apply Code" Height="38" Style="{StaticResource PrimaryButtonStyle}" Click="SaveCustomCode_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- OS PASSWORD CONFIGURATION MODAL OVERLAY                           -->
        <!-- ================================================================= -->
        <Grid Grid.ColumnSpan="2" x:Name="OsPasswordModalOverlay" Visibility="Collapsed" 
              Background="#660F172A" Panel.ZIndex="1003" MouseDown="OsPasswordModalOverlay_MouseDown"
              SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1" 
                    Width="380" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24"
                    SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="Configure OS Password" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0" Foreground="#64748B" FontSize="13" FontWeight="Bold"
                                Cursor="Hand" Click="CloseOsPasswordModal_Click"/>
                    </Grid>

                    <TextBlock Grid.Row="1" x:Name="OsPasswordModalTargetText" Text="For target PC" FontSize="12" Foreground="#64748B" Margin="0,4,0,16"/>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="WINDOWS OS / SIGN-IN PASSWORD" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                        <PasswordBox x:Name="OsPasswordModalInput" Style="{StaticResource ModernPasswordBoxStyle}" Height="40"
                                     FontSize="15" HorizontalContentAlignment="Center" KeyDown="OsPasswordModalInput_KeyDown"/>
                        <TextBlock Text="Used to automatically unlock the remote Windows sign-in screen." FontSize="11" Foreground="#94A3B8" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" x:Name="OsPasswordModalStatusText" Text="" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" 
                               HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed"/>

                    <StackPanel Grid.Row="4" Margin="0,18,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Cancel" Height="38" Style="{StaticResource SecondaryButtonStyle}" Click="CloseOsPasswordModal_Click"/>
                            <Button Grid.Column="2" Content="Save Password" Height="38" Style="{StaticResource PrimaryButtonStyle}" Click="SaveOsPasswordModal_Click"/>
                        </Grid>
                        <Button x:Name="OsPasswordModalForgetBtn" Content="Remove saved OS password" 
                                Background="Transparent" BorderThickness="0" Foreground="#DC2626" FontSize="11" FontWeight="Medium"
                                Cursor="Hand" HorizontalAlignment="Center" Margin="0,8,0,0"
                                Click="OsPasswordModalForgetBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
