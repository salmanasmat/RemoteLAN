<Window x:Class="RemoteLAN.Controller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RemoteLAN Controller" Height="740" Width="1060"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC" Foreground="#0F172A"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Control Bar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,10">
            <StackPanel>
                <!-- Upper Row: Branding + Auto-Discovery + Stats -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Branding -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                        <Border Width="10" Height="10" CornerRadius="5" x:Name="StatusDot" Background="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="RemoteLAN" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <Border Background="#E0F2FE" CornerRadius="4" Padding="5,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v0.2.0" FontSize="11" FontWeight="SemiBold" Foreground="#0284C7"/>
                        </Border>
                    </StackPanel>

                    <!-- Auto-Discovery Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="LAN DISCOVERY:" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" FontWeight="Bold"/>
                        <ComboBox x:Name="DiscoveredPcsComboBox" Width="260" Background="#F8FAFC" Foreground="#0F172A"
                                  BorderBrush="#CBD5E1" Padding="8,5" FontSize="12" VerticalContentAlignment="Center"
                                  SelectionChanged="DiscoveredPcsComboBox_SelectionChanged" Margin="0,0,8,0"/>
                        <Button x:Name="ScanLanBtn" Content="Scan LAN" Click="ScanLanBtn_Click" Padding="12,5" Background="#F1F5F9"
                                Foreground="#1E293B" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontWeight="Medium"/>
                        <TextBlock x:Name="ScanStatusText" Text="" Foreground="#0284C7" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- Quick Stats -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="FpsTextBlock" Text="0.0 FPS" Foreground="#0284C7" FontWeight="Bold" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ResolutionTextBlock" Text="-- x --" Foreground="#64748B" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Lower Row: Target IP + Port + PIN + Connect -->
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="TARGET IP:" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" FontWeight="Bold"/>
                        <TextBox x:Name="TargetIpTextBox" Text="127.0.0.1" Width="140" Background="#F8FAFC" Foreground="#0F172A" 
                                 BorderBrush="#CBD5E1" Padding="8,5" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,16,0"/>

                        <TextBlock Text="PORT:" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" FontWeight="Bold"/>
                        <TextBox x:Name="TargetPortTextBox" Text="9191" Width="65" Background="#F8FAFC" Foreground="#0F172A" 
                                 BorderBrush="#CBD5E1" Padding="8,5" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,16,0"/>

                        <TextBlock Text="PIN:" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" FontWeight="Bold"/>
                        <TextBox x:Name="PinTextBox" Width="100" Background="#F8FAFC" Foreground="#0F172A" 
                                 BorderBrush="#CBD5E1" Padding="8,5" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,16,0"/>

                        <Button x:Name="ConnectBtn" Content="Connect" Click="ConnectBtn_Click" Padding="20,7" Background="#2563EB" 
                                Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>

                        <CheckBox x:Name="EnableInputCheckBox" Content="Send Remote Input" IsChecked="True" Foreground="#334155" 
                                  VerticalAlignment="Center" Margin="24,0,0,0" Cursor="Hand" FontWeight="Medium"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Viewport Area -->
        <Grid Grid.Row="1" Background="#F1F5F9">
            <!-- Disconnected Placeholder -->
            <StackPanel x:Name="PlaceholderPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="68" Height="68" CornerRadius="34" Background="#E2E8F0" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="🖥️" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Not Connected" FontSize="20" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                <TextBlock Text="Scan LAN or enter target PC's IP and PIN, then click Connect." FontSize="13" Foreground="#64748B" Margin="0,6,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Screen Viewport -->
            <Border x:Name="ViewportContainer" Focusable="True" Visibility="Collapsed" Background="#0F172A"
                    PreviewKeyDown="ViewportContainer_PreviewKeyDown"
                    PreviewKeyUp="ViewportContainer_PreviewKeyUp">
                <Image x:Name="ScreenViewport" Stretch="Uniform"
                       MouseMove="ScreenViewport_MouseMove"
                       MouseDown="ScreenViewport_MouseDown"
                       MouseUp="ScreenViewport_MouseUp"
                       MouseWheel="ScreenViewport_MouseWheel"
                       Cursor="Cross"/>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusMessageText" Text="Ready to connect" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="RemoteLAN Controller • Direct LAN" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
